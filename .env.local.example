# Environment Variables

# Active provider:
# - gemini-aistudio: call Google AI Studio directly with GEMINI_API_KEY.
# - ai-gateway: call the private AI gateway below.
AI_PROVIDER=gemini-aistudio

# Gemini AI Studio provider.
GEMINI_API_KEY=your_gemini_ai_studio_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=
GEMINI_EXPORT_MODEL=
GEMINI_FORMULA_MODEL=

# AI Gateway - all chat/export/vision calls go through this gateway.
# The app calls /v1/vertex/generate first and falls back to /v1/gemini/generate.
AI_GATEWAY_PRIMARY_URL=https://gateway.domains.com
AI_GATEWAY_PRIMARY_KEY=org_your_gateway_key_here

# Default model used by chat, export variants, and Math Studio recognition.
AI_GATEWAY_MODEL=gemini-2.5-flash

# Optional provider preference. Leave empty to try Vertex first, then Gemini.
AI_GATEWAY_PROVIDER=

# Optional custom generate route, for example /v1/gemini/generate.
AI_GATEWAY_GENERATE_PATH=

# Keep async enabled to avoid Cloudflare 524 on long gateway generations.
AI_GATEWAY_ASYNC=true

# Gateway wait limits in milliseconds.
# Keep this short enough that a stuck provider does not freeze the chat for minutes.
# Very large jobs should be split into smaller tasks/sub-agent batches.
AI_GATEWAY_SYNC_TIMEOUT_MS=35000
AI_GATEWAY_ASYNC_TIMEOUT_MS=45000

# Optional per-feature model overrides.
AI_GATEWAY_CHAT_MODEL=
AI_GATEWAY_EXPORT_MODEL=
AI_GATEWAY_FORMULA_MODEL=

# Backward-compatible formula override. Prefer AI_GATEWAY_FORMULA_MODEL for new setups.
FORMULA_RECOGNITION_MODEL=

# Model name shown in UI (public, accessible from client).
NEXT_PUBLIC_MODEL_NAME=Gemini

# Optional when a GitHub Pages/static frontend calls a separately deployed backend.
NEXT_PUBLIC_API_BASE_URL=
